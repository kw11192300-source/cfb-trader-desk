# Copy this file to .env.local and fill in real values for local development.
# In production (Vercel), set these same names as Project Environment Variables instead.

# Supabase project settings -> API (new publishable/secret key format)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# https://collegefootballdata.com/key (free)
CFBD_API_KEY=paste-your-cfbd-api-key-here

# https://the-odds-api.com/ (free tier, 500 credits/mo) — real spread/total juice + more books
ODDS_API_KEY=paste-your-odds-api-key-here

# Optional — Telegram bot for edge alerts + texting bets in (python/alerts/).
# Message @BotFather to create a bot and get a token; message your own bot
# once, then visit https://api.telegram.org/bot<token>/getUpdates to read
# your chat id back out. Leave blank to leave this feature off — every
# caller treats a missing token as "not configured," not an error.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Site-wide password gate (src/proxy.ts) - leave blank to leave the
# whole site open with no login (e.g. local dev). Set in Vercel too once
# you've picked a real password.
SITE_PASSWORD=
